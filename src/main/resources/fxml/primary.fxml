<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #0F0F12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="KeystormArena.fxcore.FXMLController">
    <children>
        <Button fx:id="btnStart" layoutX="200.0" layoutY="144.0" onAction="#btnStartA" onMouseEntered="#ButtonEntered" onMouseExited="#ButtonExited" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="Start" textFill="#eaeaea">
         <font>
            <Font name="Consolas" size="34.0" />
         </font></Button>
        <Label fx:id="lblTitle" layoutX="156.0" layoutY="8.0" minHeight="16" minWidth="69" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="87.0" prefWidth="317.0" text="KeyStorm Arena" textFill="#eaeaea">
         <font>
            <Font size="41.0" />
         </font></Label>
      <Button fx:id="btnExit" layoutX="200.0" layoutY="322.0" onAction="#btnExitA" onMouseEntered="#ButtonEntered" onMouseExited="#ButtonExited" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="Exit" textFill="#eaeaea">
         <font>
            <Font name="Consolas" size="34.0" />
         </font>
      </Button>
      <Label fx:id="Akey" layoutX="40.0" layoutY="82.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="-9.8" text="A" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Label fx:id="Skey" layoutX="90.0" layoutY="182.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="-2.7" text="S" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Label fx:id="Dkey" layoutX="40.0" layoutY="288.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="10.5" text="D" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Label fx:id="Jkey" layoutX="501.0" layoutY="85.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="9.0" text="J" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Label fx:id="Kkey" layoutX="444.0" layoutY="182.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="14.5" text="K" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Label fx:id="Lkey" layoutX="474.0" layoutY="288.0" onMouseEntered="#LabelEntered" onMouseExited="#LabelExited" prefHeight="78.0" prefWidth="29.0" rotate="-10.5" text="L" textFill="#eaeaea">
         <font>
            <Font name="Consolas Bold" size="73.0" />
         </font>
      </Label>
      <Button fx:id="btnTutorial" layoutX="200.0" layoutY="234.0" onAction="#btnTutorialA" onMouseEntered="#ButtonEntered" onMouseExited="#ButtonExited" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="Tutorial" textFill="#eaeaea">
         <font>
            <Font name="Consolas" size="34.0" />
         </font>
      </Button>
      <Pane fx:id="PaneTutorial" layoutX="142.0" layoutY="105.0" prefHeight="289.0" prefWidth="317.0" style="-fx-background-color: #0F0F12;" visible="false">
         <children>
            <Label fx:id="lblTutorial" layoutY="-11.0" minHeight="16" minWidth="69" prefHeight="251.0" prefWidth="317.0" text="A,S,D,J,K,L these keys will fall and when they touch the white bar click the corresponding key on your keyboard matching the key to earn points. If you miss or click a key without it touching the bar you lose points. If your score reachs 0 you get sent back to the main menu and restart. Hit escape to go to main menu" textFill="#eaeaea" wrapText="true">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="btnOkay" layoutX="127.0" layoutY="239.0" mnemonicParsing="false" onAction="#btnOkayA" onMouseEntered="#ButtonEntered" onMouseExited="#ButtonExited" style="-fx-background-color: transparent;" text="Okay" textFill="#eaeaea">
               <font>
                  <Font size="17.0" />
               </font>
            </Button>
         </children>
      </Pane>
    </children>
</AnchorPane>
